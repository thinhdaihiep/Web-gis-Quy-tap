rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toàn bộ truy xuất database đã được chuyển 100% sang Firebase Admin SDK trên Backend.
    // Chặn triệt để mọi truy cập trực tiếp từ Web/Client để bảo vệ dữ liệu.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
