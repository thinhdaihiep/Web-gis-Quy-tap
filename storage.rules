rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Cho phép tất cả người dùng đọc dữ liệu raster công khai
      allow read: if true;
      // Chặn hoàn toàn ghi trực tiếp từ Client, toàn bộ dữ liệu ghi qua Backend Admin SDK
      allow write: if false;
    }
  }
}
