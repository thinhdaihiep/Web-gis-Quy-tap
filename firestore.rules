rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly block direct client access to users collection
    match /users/{userId} {
      allow read, write: if false;
    }

    // Default open access for map layers, settings, and other app collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
